# Copy this file to .env and fill in your values
# Never commit .env to git

# ═══════════════════════════════════════════════════════════════════════════
#  DATABASE
# ═══════════════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberrange
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ═══════════════════════════════════════════════════════════════════════════
#  SECURITY — REQUIRED FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════

# Generate a strong secret key with: openssl rand -hex 32
# MUST be at least 32 characters and randomly generated
# DO NOT use the default development value in production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Environment type: 'development' or 'production'
ENVIRONMENT=development

# Comma-separated list of allowed origins (CORS)
# Set to your frontend URL in production: https://app.example.com,https://platform.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Token expiration time in minutes (default: 720 = 12 hours)
TOKEN_EXPIRE_MINUTES=720

# ═══════════════════════════════════════════════════════════════════════════
#  INFRASTRUCTURE
# ═══════════════════════════════════════════════════════════════════════════

# Infrastructure backend: simulate | proxmox
PROVISIONING_BACKEND=simulate

# Proxmox cluster settings (only needed when PROVISIONING_BACKEND=proxmox)
PROXMOX_HOST=your.proxmox.host
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=cyberrange
PROXMOX_TOKEN_VALUE=your_api_token_here
# Root password — used only to generate short-lived noVNC console tickets
# so learners can open VM consoles without seeing the Proxmox login screen
PROXMOX_PASSWORD=your_proxmox_root_password_here
PROXMOX_NODE=pve1
PROXMOX_NODES=pve1:your.proxmox.host,pve2:your.proxmox.host2
PROXMOX_VERIFY_SSL=false

# ═══════════════════════════════════════════════════════════════════════════
#  LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Audit log file path
AUDIT_LOG_PATH=logs/audit.log
